# Server
# The controller must bind to a loopback address. 0.0.0.0 is rejected at startup.
HOST=127.0.0.1
PORT=2014

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Web search backend: google | duckduckgo
SEARCH_ENGINE=google

# Comma-separated folders Spotlight may search ("Alexa, search my files for X").
# Empty = file search disabled. Never the whole filesystem.
SEARCH_ROOTS=~/Developer,~/Documents

# Alexa skill verification. Set to your skill's application ID to enable the
# /alexa endpoint; unset = endpoint disabled.
ALEXA_SKILL_ID=

# Project folder opened by "open the backend project" (empty = disabled).
DEVELOPER_ROOT=~/Developer

# Shortcut name run by "start coding mode" (empty = disabled).
SHORTCUT_CODING_MODE=Mac - Coding Mode
